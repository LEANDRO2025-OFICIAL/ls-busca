# Copie para .env.local e preencha. Nunca versione o .env.local.

# Postgres de verdade (Neon, Supabase, local...). RECOMENDADO para uso diário; passo a passo no README.
# Ex.: postgres://usuario:senha@host:5432/lsbusca?sslmode=require
# Sem esta variável, o app usa o Postgres embutido (PGlite) em .data/pglite, que só aceita
# UM processo por vez (protegido pela trava .data/pglite.lock).
DATABASE_URL=

# --- TLS do banco (com DATABASE_URL) ---
# Em produção o certificado do servidor é validado. Bancos gerenciados com CA pública
# (Supabase, Neon) funcionam sem configuração extra na URL com ?sslmode=require.
# CA própria em PEM (quebras de linha podem vir como \n):
# DATABASE_SSL_CA=
# Só use se souber o risco: desliga a validação do certificado.
# DATABASE_SSL_NO_VERIFY=0

# --- Só para o banco embutido (ignorados com DATABASE_URL) ---
# Cópias de segurança automáticas em .data/backups (antes de migração, de troca de senha e periódicas). 0 desliga.
# BACKUP_AUTOMATICO=1
# Quantas cópias manter (padrão 3).
# BACKUP_RETENCAO=3
# Intervalo, em horas, da cópia periódica (padrão 24).
# BACKUP_INTERVALO_HORAS=24
# Tamanho máximo, em MB, do banco para a cópia com o servidor aberto (padrão 512).
# BACKUP_DUMP_MAX_MB=512
# Pasta do banco embutido (padrão .data/pglite).
# PGLITE_PASTA=
# Portas em que o LS Busca pode estar no ar, conferidas pelos scripts antes de mexer no banco (padrão 3000,3100).
# LS_BUSCA_PORTAS=3000,3100

# OBRIGATÓRIO: sem ele as rotas de cron respondem 503 (nunca ficam abertas por falta de configuração).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Cadastro público ("Criar conta"). Fechado por padrão: só abre com a base vazia
# (primeira conta) ou com CADASTRO_ABERTO=1. Novas pessoas entram por Configurações > Equipe.
CADASTRO_ABERTO=

# --- Licença e teste gratuito ---
# E-mail(s) do dono do sistema (nível máximo), separados por vírgula. SÓ eles enxergam e usam a
# tela /sistema/licencas para ativar, renovar ou bloquear a licença das contas. Vazio = ninguém
# (a tela responde 404). Não é o admin de órgão comum. Ex.: EMAIL_DONO_SISTEMA=voce@exemplo.com
EMAIL_DONO_SISTEMA=

# Identificador da licença/cliente, embutido no HTML entregue (marca d'água) para rastrear
# vazamento. Deixe único por cliente. Vazio = "sem-identificacao". Ver docs/PROTECAO-E-LICENCA.md.
LICENCA_ID=

# --- Alertas, comunidade e avisos ---
# Webhook opcional: recebe por POST (JSON descrito no README) os avisos novos dos alertas e da
# comunidade de grandes licitações. Vazio = só avisos na tela. Falha no envio não derruba a ingestão.
ALERTA_WEBHOOK_URL=
# Tempo limite do webhook em milissegundos (padrão 5000; entre 500 e 30000).
# ALERTA_WEBHOOK_TIMEOUT_MS=5000
# Valor estimado mínimo, em reais, do mural de grandes licitações (padrão 10000000).
# COMUNIDADE_VALOR_MINIMO=10000000

# --- Robô de lance: criptografia das credenciais de portal ---
# OBRIGATÓRIO em produção (mínimo 32 caracteres). Sem ele o app NÃO SOBE: antes havia um
# fallback público ("robo-key-dev-nao-usar-em-producao!!") versionado no Git, que permitia
# decifrar as credenciais de qualquer cliente. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATENÇÃO: trocar esta chave invalida as credenciais já salvas (precisam ser recadastradas).
ROBO_KEY=
