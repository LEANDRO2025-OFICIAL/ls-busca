# Copie para .env.local e preencha. Nunca versione o .env.local.

# Postgres gerenciado (Neon, Supabase ou outro). Sem esta variável, o app usa o
# Postgres embutido (PGlite) em .data/pglite, só para desenvolvimento.
DATABASE_URL=

# Segredo que o cron envia em "Authorization: Bearer ..." para /api/cron/ingerir
# e /api/cron/sincronizar-fontes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Cadastro público ("Criar conta"). Fechado por padrão: só abre com a base vazia
# (primeira conta) ou com CADASTRO_ABERTO=1. Novas pessoas entram por Configurações > Equipe.
CADASTRO_ABERTO=

# ─── Fontes externas de dados ────────────────────────────────────────────────

# Chave AES-256-GCM para cifrar credenciais das fontes no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deve ter exatamente 64 caracteres hex (= 32 bytes).
FONTES_ENCRYPTION_KEY=

# ─── Alertas por e-mail (Gmail SMTP) ─────────────────────────────────────────
# Conta Gmail que envia os alertas de novas licitações.
GMAIL_USER=lslicitacoes22@gmail.com

# Senha de app do Gmail (não a senha normal).
# Gere em: Conta Google → Segurança → Senhas de app
GMAIL_APP_PASSWORD=

# ─── Alertas por WhatsApp (opcional) ─────────────────────────────────────────
# URL e token da API de WhatsApp Business quando estiver configurada.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
